# Copy to .env and adjust as needed.

# Database. Defaults to local SQLite; swap for Postgres in production, e.g.:
# postgresql+psycopg2://documind:documind@localhost:5432/documind
DATABASE_URL=sqlite:///./documind.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

VECTOR_DB_PATH=./data/chroma
UPLOAD_DIR=./data/uploads

# LLM_PROVIDER: ollama | none
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_BASE_URL=http://localhost:11434

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

MAX_UPLOAD_SIZE=20971520
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.25
